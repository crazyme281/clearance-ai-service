# Supabase project (Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role key — server-side only, NEVER ship this to the Ionic app.
# It bypasses RLS, which is required for the AI tools to read across
# a student's related rows (documents, payments, stage instances).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon key — used only to verify the JWT a request arrives with.
SUPABASE_ANON_KEY=your-anon-key

# LLM provider for tool-calling (Groq — fast + generous free tier)
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated origins allowed to call this API (your Ionic app's origin(s))
ALLOWED_ORIGINS=http://localhost:8100,capacitor://localhost
